# ─── Vedic Astrology API — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values
# cp .env.example .env

# ── API Keys ──────────────────────────────────────────────────────────────────
# Comma-separated list of valid API keys
# Generate a key: python -c "import secrets; print('astro-' + secrets.token_urlsafe(32))"
API_KEYS=your-secret-api-key-here

# ── App Settings ──────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=text   # 'text' for development, 'json' for production

# ── Swiss Ephemeris ───────────────────────────────────────────────────────────
EPHE_PATH=./ephe

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
